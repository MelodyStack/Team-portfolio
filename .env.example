# ───────────────────────────────────────────────────────────────────────────
#  Contact form email
# ───────────────────────────────────────────────────────────────────────────
#
#  Copy this file to `.env.local` and fill in the blanks. `.env.local` is
#  gitignored; this template is committed so the required variables are
#  discoverable.
#
#  None of these are NEXT_PUBLIC_*, so none of them reach the browser. The
#  API key is read only inside a server action.

# Where enquiries are delivered. Change this one line to redirect the form.
CONTACT_TO_EMAIL=you@example.com

# The From address on the email we send.
#
# It must be on a domain you have verified with your email provider, but it
# does NOT need to be a real mailbox, so noreply@yourdomain works even if you
# only run one inbox. Resend gives you onboarding@resend.dev to test with
# before you verify your own domain.
#
# Keep this different from CONTACT_TO_EMAIL where you can: some spam filters
# treat From == To as suspicious. Replies still reach the enquirer either way,
# because the send sets reply_to to them.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# API key from https://resend.com (free tier covers a contact form easily).
#
# Leave this blank and the form still works: it falls back to composing the
# message in the visitor's mail client, exactly as it did before sending was
# wired up. It never silently swallows an enquiry.
RESEND_API_KEY=
